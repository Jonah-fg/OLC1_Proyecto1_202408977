<?xml version="1.0" encoding="UTF-8"?>

<project name="EjemploClase" default="compile" basedir=".">

    <description>
        Builds, tests, and runs the project EjemploClase.
    </description>

    <!-- Carpetas -->
    <property name="cup" location="src/cup"/>
    <property name="jflex" location="src/jflex"/>
    <property name="java" location="src"/>
    <property name="classes" location="bin"/>
    <property name="lib" location="lib"/>
    <property name="tools" location="tools"/>

    <!-- JFlex -->
    <taskdef
            name="jflex"
            classname="jflex.anttask.JFlexTask"
            classpath="${tools}/jflex-full-1.9.1.jar"/>

    <!-- Java CUP -->
    <taskdef
            name="cup"
            classname="java_cup.anttask.CUPTask"
            classpath="${tools}/java-cup-11b.jar"/>

    <!-- Generar Lexer y Parser -->
    <target name="generate">

        <jflex
                file="${jflex}/Scanner.jflex"
                destdir="${java}"/>

        <cup
                srcfile="${cup}/Parser.cup"
                destdir="${java}"
                parser="Parser"
                interface="true"
                locations="false"/>

    </target>

    <!-- Librerías -->
    <path id="libraries">
        <pathelement location="${lib}/java-cup-11b-runtime.jar"/>
    </path>

    <!-- Compilar -->
    <target name="compile" depends="generate">
        <mkdir dir="${classes}"/>

        <javac
                srcdir="${java}"
                destdir="${classes}"
                includeantruntime="false">
            <classpath refid="libraries"/>
        </javac>
    </target>

    <!-- Limpiar archivos generados -->
    <target name="clean">

        <delete file="${java}/analisis/Lexer.java"/>
        <delete file="${java}/analisis/Parser.java"/>
        <delete file="${java}/analisis/sym.java"/>

        <delete dir="${classes}"/>

    </target>

</project>